# Copie este arquivo para `.env` e ajuste os valores.
# Em produção, NUNCA comite o `.env` real — ele está no .gitignore.

# Ambiente: development | testing | production
FLASK_ENV=development

# Chave usada para assinar cookies de sessão.
# Em produção, gere algo como: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# URL do banco (SQLAlchemy). Em produção, use postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Origens permitidas para CORS (separadas por vírgula). Em dev, o Vite roda em 5173.
CORS_ORIGINS=http://localhost:5173

# Quando true, o Flask serve o build do React em rotas não-/api.
# Deve ser true apenas em produção (ou ao testar o build localmente).
SERVE_SPA=false

# Caminho para o dist/ do React. Default relativo a este backend/.
FRONTEND_DIST=../frontend/dist